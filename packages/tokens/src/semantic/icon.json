{
  "icon": {
    "$description": "Semantic icon colors. `display` = decorative/static. `interactive` = clickable icons.",
    "display": {
      "primary":   { "$value": "{color.gray.600}",  "$type": "color" },
      "secondary": { "$value": "{color.gray.400}",  "$type": "color" },
      "info":      { "$value": "{color.blue.600}",  "$type": "color" },
      "warning":   { "$value": "{color.orange.600}","$type": "color" },
      "error":     { "$value": "{color.red.600}",   "$type": "color" },
      "success":   { "$value": "{color.green.600}", "$type": "color" },
      "increase":  { "$value": "{color.green.600}", "$type": "color" },
      "decrease":  { "$value": "{color.red.600}",   "$type": "color" }
    },
    "interactive": {
      "primary":   { "$value": "{color.blue.600}",  "$type": "color" },
      "secondary": { "$value": "{color.gray.600}",  "$type": "color" },
      "info":      { "$value": "{color.blue.700}",  "$type": "color" },
      "warning":   { "$value": "{color.orange.700}","$type": "color" },
      "error":     { "$value": "{color.red.700}",   "$type": "color" },
      "success":   { "$value": "{color.green.700}", "$type": "color" },
      "increase":  { "$value": "{color.green.700}", "$type": "color" },
      "decrease":  { "$value": "{color.red.700}",   "$type": "color" }
    }
  }
}
