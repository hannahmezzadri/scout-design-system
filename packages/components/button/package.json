{
  "name": "@scout/button",
  "version": "0.1.0",
  "description": "Scout Button — clickable element that triggers an action or event",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
