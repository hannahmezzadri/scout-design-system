  "dependencies": { "lit": "^3.2.0", "@scout/tokens": "workspace:*", "@scout/control": "workspace:*" },
  "devDependencies": { "tsup": "^8.3.0", "typescript": "^5.6.3" },
  "publishConfig": { "access": "restricted" },
  "sideEffects": ["./dist/**/*.js"]
}
