{
  "name": "@connex/accordion",
  "version": "0.1.0",
  "description": "Connex Accordion — vertically stacked rows that reveal or hide content",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "lit": "^3.2.0",
    "@connex/tokens": "workspace:*"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "@connex/tokens": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": ["./dist/**/*.js"]
}
