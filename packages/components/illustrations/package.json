{
  "name": "@connex/illustrations",
  "version": "0.1.0",
  "description": "Connex Illustrations — token-driven SVG illustrations. Each illustration is its own custom element so consumers tree-shake to only the artwork they import.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":           { "types": "./dist/index.d.ts",          "import": "./dist/index.js" },
    "./base":      { "types": "./dist/base.d.ts",           "import": "./dist/base.js" },
    "./accordion": { "types": "./dist/accordion.d.ts",      "import": "./dist/accordion.js" },
    "./address":   { "types": "./dist/address.d.ts",        "import": "./dist/address.js" },
    "./avatar":    { "types": "./dist/avatar.d.ts",         "import": "./dist/avatar.js" }
  },
  "files": ["dist"],
  "scripts": { "build": "tsup", "dev": "tsup --watch", "clean": "rm -rf dist .turbo" },
  "peerDependencies": { "lit": "^3.2.0", "@connex/tokens": "workspace:*" },
  "dependencies": { "lit": "^3.2.0", "@connex/tokens": "workspace:*" },
  "devDependencies": { "tsup": "^8.3.0", "typescript": "^5.6.3" },
  "publishConfig": { "access": "restricted" },
  "sideEffects": ["./dist/**/*.js"]
}
