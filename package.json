{
  "name": "scout",
  "version": "0.0.0",
  "private": true,
  "description": "Scout — enterprise design system (root)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "pnpm --filter @scout-ds/tokens build",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/components/*\" --filter \"./packages/tokens\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
